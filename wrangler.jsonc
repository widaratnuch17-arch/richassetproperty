{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rich-asset-property",
  "account_id": "4d8e45f947aeb46c513e0b28847bb69d",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rich-asset-property-db",
      "database_id": "adad82ca-8e3e-4ea3-900a-7a239a5ab86a",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
